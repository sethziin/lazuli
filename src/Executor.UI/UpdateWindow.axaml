<Window Background="{StaticResource ChromeSolid}" xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        x:Class="Executor.UI.UpdateWindow"
        Title="Lazuli · Update" Icon="avares://Lazuli/Assets/lazuli.ico"
        Width="460" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="38"
        WindowDecorations="BorderOnly">

  <Grid RowDefinitions="38,Auto,Auto">

    <!-- Barra de título -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
      <Border Background="Transparent" chrome:WindowDecorationProperties.ElementRole="TitleBar">
        <TextBlock Text="Updates" FontWeight="SemiBold" Margin="16,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
      </Border>
      <Button Grid.Column="1" Classes="caption close" x:Name="CloseBtn">
        <Path Classes="icon" Data="{StaticResource IconClose}" />
      </Button>
      <Border Grid.ColumnSpan="2" Classes="hline" VerticalAlignment="Bottom" IsHitTestVisible="False" />
    </Grid>

    <!-- Corpo -->
    <StackPanel Grid.Row="1" Margin="24,22,24,20" Spacing="16">

      <Grid ColumnDefinitions="Auto,*">
        <Border Width="40" Height="40" CornerRadius="20" BorderBrush="{StaticResource LineStrong}" BorderThickness="1"
                Background="{StaticResource Panel}" VerticalAlignment="Top">
          <Path x:Name="HeroIcon" Data="{StaticResource IconDownload}" Stroke="{StaticResource Text}" StrokeThickness="1.7"
                StrokeLineCap="Round" StrokeJoin="Round" Stretch="Uniform" Width="18" Height="18"
                HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel Grid.Column="1" Margin="14,0,0,0" Spacing="3" VerticalAlignment="Center">
          <TextBlock x:Name="TitleText" Classes="pagetitle" Text="New version available" />
          <TextBlock x:Name="SubtitleText" Classes="muted" FontSize="12" Text="" />
        </StackPanel>
      </Grid>

      <!-- Novidades -->
      <Border x:Name="NotesCard" Classes="card" Background="{StaticResource Editor}" Padding="14,12">
        <StackPanel Spacing="8">
          <TextBlock Classes="section" Text="WHAT'S NEW" />
          <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="NotesList">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                  <Grid ColumnDefinitions="14,*" Margin="0,0,0,4">
                    <TextBlock Classes="faint" Text="•" />
                    <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </StackPanel>
      </Border>

      <!-- Progresso -->
      <StackPanel x:Name="ProgressBox" Spacing="8" IsVisible="False">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock x:Name="StatusText" Classes="muted" FontSize="12" Text="" TextTrimming="CharacterEllipsis" />
          <TextBlock x:Name="PercentText" Grid.Column="1" FontSize="12" Text="" />
        </Grid>
        <ProgressBar x:Name="Bar" Classes="update" Minimum="0" Maximum="100" Value="0" />
      </StackPanel>

      <TextBlock x:Name="ErrorText" Foreground="#E8837B" FontSize="12" TextWrapping="Wrap" IsVisible="False" />
    </StackPanel>

    <!-- Rodapé -->
    <Border Grid.Row="2">
      <DockPanel>
        <Border DockPanel.Dock="Top" Classes="hline" />
        <Grid ColumnDefinitions="*,Auto,Auto" Height="58" Margin="20,0">
          <TextBlock x:Name="FootText" Classes="faint" FontSize="11.5" VerticalAlignment="Center" Text="" />
          <Button Grid.Column="1" x:Name="SecondaryBtn" Classes="secondary" Content="Later" VerticalAlignment="Center" Margin="0,0,8,0" />
          <Button Grid.Column="2" x:Name="PrimaryBtn" Classes="secondary default" Content="Update now" VerticalAlignment="Center" />
        </Grid>
      </DockPanel>
    </Border>
  </Grid>
</Window>
