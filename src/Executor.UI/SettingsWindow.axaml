<Window Background="{StaticResource ChromeSolid}" xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        xmlns:vm="using:Executor.UI.ViewModels"
        x:Class="Executor.UI.SettingsWindow"
        x:DataType="vm:MainViewModel"
        Title="Lazuli · Settings" Icon="avares://Lazuli/Assets/lazuli.ico"
        Width="700" Height="540" CanResize="False" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="38"
        WindowDecorations="BorderOnly">

  <Grid RowDefinitions="38,*">

    <!-- Barra de título -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
      <Border Background="Transparent" chrome:WindowDecorationProperties.ElementRole="TitleBar">
        <TextBlock Text="Settings" FontWeight="SemiBold" Margin="16,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
      </Border>
      <Button Grid.Column="1" Classes="caption close" x:Name="CloseBtn">
        <Path Classes="icon" Data="{StaticResource IconClose}" />
      </Button>
      <Border Grid.ColumnSpan="2" Classes="hline" VerticalAlignment="Bottom" IsHitTestVisible="False" />
    </Grid>

    <!-- Corpo -->
    <Grid Grid.Row="1" ColumnDefinitions="184,*">
      <ListBox x:Name="Nav" Classes="nav" Margin="10,6,10,10" SelectedIndex="0">
        <ListBoxItem>Editor</ListBoxItem>
        <ListBoxItem>Interface</ListBoxItem>
        <ListBoxItem>Appearance</ListBoxItem>
        <ListBoxItem>Session</ListBoxItem>
        <ListBoxItem>About</ListBoxItem>
      </ListBox>

      <Border Grid.Column="1" Background="{StaticResource Editor}" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0">
        <DockPanel>

          <!-- Rodapé -->
          <Border DockPanel.Dock="Bottom">
            <DockPanel>
              <Border DockPanel.Dock="Top" Classes="hline" />
              <Grid ColumnDefinitions="Auto,*,Auto" Height="58" Margin="20,0">
                <Button Classes="secondary" Content="Restore defaults" VerticalAlignment="Center"
                        Command="{Binding ResetSettingsCommand}" />
                <Button Grid.Column="2" x:Name="DoneBtn" Classes="secondary default" Content="Close" VerticalAlignment="Center" />
              </Grid>
            </DockPanel>
          </Border>

          <Panel>

            <!-- Editor -->
            <StackPanel x:Name="PageEditor" Margin="28,22,28,0">
              <TextBlock Classes="pagetitle" Text="Editor" Margin="0,0,0,14" />
              <Grid Classes="field" ColumnDefinitions="170,*">
                <TextBlock Classes="label" Text="Font size" />
                <ComboBox Grid.Column="1" HorizontalAlignment="Left" Width="100" ItemsSource="{Binding FontSizes}"
                          SelectedItem="{Binding Settings.EditorFontSize}" VerticalAlignment="Center" />
              </Grid>
              <Grid Classes="field" ColumnDefinitions="170,*">
                <TextBlock Classes="label" Text="Syntax theme" />
                <ComboBox Grid.Column="1" HorizontalAlignment="Left" Width="190" ItemsSource="{Binding ThemeOptions}"
                          SelectedValueBinding="{ReflectionBinding Key}"
                          SelectedValue="{Binding Settings.SyntaxTheme}" VerticalAlignment="Center" />
              </Grid>
              <Grid Classes="field" ColumnDefinitions="170,*">
                <TextBlock Classes="label" Text="Tab size" />
                <ComboBox Grid.Column="1" HorizontalAlignment="Left" Width="100" ItemsSource="{Binding TabSizes}"
                          SelectedItem="{Binding Settings.TabSize}" VerticalAlignment="Center" />
              </Grid>
              <Border Classes="hline" Margin="0,12,0,14" />
              <Grid ColumnDefinitions="170,*">
                <TextBlock Classes="label" Text="Display" VerticalAlignment="Top" />
                <StackPanel Grid.Column="1" Spacing="14">
                  <CheckBox Content="Line numbers" IsChecked="{Binding Settings.ShowLineNumbers}" />
                  <CheckBox Content="Highlight current line" IsChecked="{Binding Settings.HighlightCurrentLine}" />
                  <CheckBox Content="Word wrap" IsChecked="{Binding Settings.WordWrap}" />
                </StackPanel>
              </Grid>
              <Border Classes="hline" Margin="0,14,0,14" />
              <Grid ColumnDefinitions="170,*">
                <TextBlock Classes="label" Text="Lua" VerticalAlignment="Top" />
                <StackPanel Grid.Column="1" Spacing="14">
                  <CheckBox Content="Auto-close ( [ { and quotes" IsChecked="{Binding Settings.AutoPairs}" />
                  <CheckBox Content="Auto-indent and close blocks (end)" IsChecked="{Binding Settings.SmartBlocks}" />
                </StackPanel>
              </Grid>
            </StackPanel>

            <!-- Interface -->
            <StackPanel x:Name="PageInterface" Margin="28,22,28,0" IsVisible="False">
              <TextBlock Classes="pagetitle" Text="Interface" Margin="0,0,0,14" />
              <Grid ColumnDefinitions="170,*" Margin="0,8,0,0">
                <TextBlock Classes="label" Text="Layout" VerticalAlignment="Top" />
                <StackPanel Grid.Column="1" Spacing="10">
                  <RadioButton x:Name="SimpleRadio" GroupName="layout" Content="Simple: editor and actions only" />
                  <RadioButton x:Name="DetailedRadio" GroupName="layout" Content="Detailed: Home, Script Hub, sidebar and more" />
                  <TextBlock Classes="faint" FontSize="11.5" Text="Changing the layout restarts the app." />
                </StackPanel>
              </Grid>
              <Border Classes="hline" Margin="0,18,0,14" />
              <Grid ColumnDefinitions="170,*" Margin="0,8,0,0">
                <TextBlock Classes="label" Text="Window" VerticalAlignment="Top" />
                <StackPanel Grid.Column="1" Spacing="14">
                  <CheckBox Content="Always on top" IsChecked="{Binding Settings.AlwaysOnTop}" />
                  <CheckBox Content="Open with Output visible" IsChecked="{Binding Settings.ShowOutputOnStart}" />
                  <CheckBox Content="Show splash screen" IsChecked="{Binding Settings.ShowSplash}" />
                </StackPanel>
              </Grid>
              <Border Classes="hline" Margin="0,18,0,14" />
              <Grid Classes="field" ColumnDefinitions="170,*">
                <TextBlock Classes="label" Text="Performance" />
                <ComboBox Grid.Column="1" HorizontalAlignment="Left" Width="230" ItemsSource="{Binding PerformanceOptions}"
                          SelectedValueBinding="{ReflectionBinding Key}"
                          SelectedValue="{Binding Settings.PerformanceMode}" VerticalAlignment="Center" />
              </Grid>
              <TextBlock Classes="faint" FontSize="12" TextWrapping="Wrap" Margin="170,2,0,0"
                         Text="Light uses software rendering (faster startup, much less memory) and turns off animations and shadows. Auto picks based on your PC. Rendering changes after restarting the app." />
            </StackPanel>

            <!-- Appearance -->
            <ScrollViewer x:Name="PageAppearance" IsVisible="False" VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="28,22,28,20">
                <TextBlock Classes="pagetitle" Text="Appearance" Margin="0,0,0,14" />

                <TextBlock Classes="section" Text="THEME" Margin="0,0,0,10" />
                <WrapPanel x:Name="ThemeSwatches" />

                <StackPanel x:Name="CustomPanel" Margin="0,14,0,0" Spacing="10" IsVisible="False">
                  <Grid ColumnDefinitions="170,Auto,10,Auto">
                    <TextBlock Classes="label" Text="Background" />
                    <TextBox x:Name="CustomBgBox" Grid.Column="1" Width="110" MaxLength="7" Watermark="#RRGGBB" />
                    <Border x:Name="CustomBgChip" Grid.Column="3" Width="26" Height="26" CornerRadius="6" BorderBrush="{StaticResource LineStrong}" BorderThickness="1" />
                  </Grid>
                  <Grid ColumnDefinitions="170,Auto,10,Auto">
                    <TextBlock Classes="label" Text="Accent" />
                    <TextBox x:Name="CustomAccentBox" Grid.Column="1" Width="110" MaxLength="7" Watermark="#RRGGBB" />
                    <Border x:Name="CustomAccentChip" Grid.Column="3" Width="26" Height="26" CornerRadius="6" BorderBrush="{StaticResource LineStrong}" BorderThickness="1" />
                  </Grid>
                  <TextBlock Classes="faint" FontSize="11.5" TextWrapping="Wrap"
                             Text="Dark backgrounds work best. Colors that are too light are darkened so text stays readable." />
                </StackPanel>

                <Border Classes="hline" Margin="0,20,0,16" />
                <TextBlock Classes="section" Text="BACKGROUND IMAGE" Margin="0,0,0,10" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button x:Name="ChooseImageBtn" Classes="secondary" Content="Choose image…" />
                  <Button x:Name="RemoveImageBtn" Classes="secondary" Content="Remove" IsEnabled="{Binding Settings.HasBackgroundImage}" />
                </StackPanel>
                <TextBlock x:Name="ImageNote" Classes="faint" FontSize="11.5" Margin="0,8,0,0" TextWrapping="Wrap" Text="PNG, JPG, BMP or WebP, up to 25 MB." />
                <Grid ColumnDefinitions="170,*,52" Margin="0,16,0,0" IsEnabled="{Binding Settings.HasBackgroundImage}">
                  <TextBlock Classes="label" Text="Readability" />
                  <Slider Grid.Column="1" Minimum="0.7" Maximum="0.97" Value="{Binding Settings.ImageDim}" />
                  <TextBlock Grid.Column="2" Classes="muted" HorizontalAlignment="Right" VerticalAlignment="Center"
                             Text="{Binding Settings.ImageDim, StringFormat='{}{0:P0}'}" />
                </Grid>
                <Grid ColumnDefinitions="170,*,52" Margin="0,8,0,0" IsEnabled="{Binding Settings.HasBackgroundImage}">
                  <TextBlock Classes="label" Text="Blur" />
                  <Slider Grid.Column="1" Minimum="0" Maximum="16" Value="{Binding Settings.ImageBlur}" />
                  <TextBlock Grid.Column="2" Classes="muted" HorizontalAlignment="Right" VerticalAlignment="Center"
                             Text="{Binding Settings.ImageBlur, StringFormat='{}{0:0}'}" />
                </Grid>
                <TextBlock Classes="faint" FontSize="11.5" Margin="0,8,0,0" TextWrapping="Wrap"
                           Text="Higher readability covers the image more, so text is easier to read." />
              </StackPanel>
            </ScrollViewer>
            <!-- Session -->
            <StackPanel x:Name="PageSession" Margin="28,22,28,0" IsVisible="False">
              <TextBlock Classes="pagetitle" Text="Session" Margin="0,0,0,14" />
              <Grid ColumnDefinitions="170,*" Margin="0,8,0,0">
                <TextBlock Classes="label" Text="Tabs" VerticalAlignment="Top" />
                <CheckBox Grid.Column="1" Content="Restore tabs on open" IsChecked="{Binding Settings.RestoreTabs}" />
              </Grid>
              <Border Classes="hline" Margin="0,18,0,12" />
              <Grid Classes="field" ColumnDefinitions="170,*">
                <TextBlock Classes="label" Text="Saved data" />
                <Button Grid.Column="1" Classes="secondary" Content="Clear saved session" HorizontalAlignment="Left"
                        VerticalAlignment="Center" Command="{Binding ClearSavedSessionCommand}" />
              </Grid>
            </StackPanel>

            <!-- Sobre -->
            <StackPanel x:Name="PageAbout" Margin="28,22,28,0" IsVisible="False">
              <TextBlock Classes="pagetitle" Text="About" Margin="0,0,0,14" />
              <Grid Classes="field" ColumnDefinitions="170,*">
                <TextBlock Classes="label" Text="Version" />
                <TextBlock Grid.Column="1" Text="{Binding Version}" VerticalAlignment="Center" />
              </Grid>
              <Grid Classes="field" ColumnDefinitions="170,*">
                <TextBlock Classes="label" Text="Backend" />
                <TextBlock x:Name="BackendText" Grid.Column="1" VerticalAlignment="Center" />
              </Grid>
              <Grid Classes="field" ColumnDefinitions="170,*">
                <TextBlock Classes="label" Text="Backend (next launch)" TextWrapping="Wrap" />
                <ComboBox x:Name="BackendCombo" Grid.Column="1" HorizontalAlignment="Left" Width="230" VerticalAlignment="Center" />
              </Grid>
              <TextBlock Classes="faint" FontSize="12" TextWrapping="Wrap" Margin="170,2,0,6"
                         Text="Lists what is in the backends\ folder next to the app. Changes apply after reopening. Only install trusted backends: manifest hashes check integrity, not authorship." />
              <Grid Classes="field" ColumnDefinitions="170,*">
                <TextBlock Classes="label" Text="Fonts" />
                <TextBlock Grid.Column="1" Text="Geist, JetBrains Mono (OFL)" VerticalAlignment="Center" />
              </Grid>
              <Grid Classes="field" ColumnDefinitions="170,*">
                <TextBlock Classes="label" Text="Data" />
                <TextBlock Grid.Column="1" Text="%APPDATA%\Lazuli" FontFamily="{StaticResource Mono}" FontSize="12" VerticalAlignment="Center" />
              </Grid>
              <Grid Classes="field" ColumnDefinitions="170,*">
                <TextBlock Classes="label" Text="Rendering" />
                <TextBlock x:Name="RenderText" Grid.Column="1" VerticalAlignment="Center" />
              </Grid>
              <Grid Classes="field" ColumnDefinitions="170,*">
                <TextBlock Classes="label" Text="Memory in use" />
                <TextBlock x:Name="MemoryText" Grid.Column="1" VerticalAlignment="Center" />
              </Grid>
            </StackPanel>
          </Panel>
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
