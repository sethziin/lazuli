<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Lazuli.UI.SplashWindow"
        Title="Lazuli" Icon="avares://Lazuli/Assets/lazuli.ico"
        Width="340" Height="190" CanResize="False" ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="None"
        Background="{StaticResource EditorSolid}">

  <Border BorderBrush="{StaticResource Line}" BorderThickness="1">
    <Grid RowDefinitions="*,Auto">
      <StackPanel x:Name="Content" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="14">
        <!-- marca: losango azul-lápis-lazúli + nome -->
        <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
          <Image Source="avares://Lazuli/Assets/lazuli.png" Width="64" Height="64" RenderOptions.BitmapInterpolationMode="HighQuality" />
        </StackPanel>
        <TextBlock x:Name="StatusText" Classes="faint" Text="Starting…" FontSize="11.5" HorizontalAlignment="Center" />
      </StackPanel>

      <TextBlock x:Name="VersionText" Grid.Row="1" Classes="faint" Text="" FontSize="10.5" HorizontalAlignment="Center"
                 Margin="0,0,0,14" />
      <ProgressBar Grid.Row="1" Classes="splash" IsIndeterminate="True" VerticalAlignment="Bottom" />
    </Grid>
  </Border>
</Window>
